# =====================================================================
# Production Environment — Rasali Labs on Hostinger VPS
# Copy this to .env on your VPS and fill in real values.
# NEVER commit this file — it is gitignored.
# =====================================================================

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=https://yidsfihagwttlmhfynmf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ----- Platform URLs -----
NEXT_PUBLIC_RASALI_PLATFORM_URL=https://rasalilabs.com
NEXT_PUBLIC_APP_URL=https://rasalilabs.com/ralion

# ----- Backend API -----
VITE_API_URL=https://rasalilabs.com/api
DATABASE_URL=postgresql://postgres.yidsfihagwttlmhfynmf:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
GOOGLE_CLOUD_PROJECT=gen-lang-client-0940432200
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-1.5-pro
JWT_SECRET=generate_a_random_64char_string_here
CORS_ORIGINS=https://rasalilabs.com
RUN_MIGRATIONS=false

# ----- OAuth -----
OAUTH_ENCRYPTION_KEY=your_32byte_aes256_key_here_change_me

# ----- Facebook / Instagram -----
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret

# ----- LinkedIn -----
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# ----- Twitter / X -----
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

# ----- TikTok -----
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

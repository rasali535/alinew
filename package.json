{
  "name": "rasalilabs-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Ras Ali Labs Unified Ecosystem",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present && node ./scripts/merge-builds.js",
    "web:dev": "npm run dev --workspace=alinew-react",
    "web:build": "npm run build --workspace=alinew-react",
    "ralion:dev": "npm run dev --workspace=@ralion/web",
    "ralion:build": "npm run build --workspace=@ralion/web",
    "desktop:build": "npm run build --workspace=@ralion/desktop",
    "desktop:dist:win": "npm run dist:win --workspace=@ralion/desktop",
    "lint": "npm run lint --workspaces --if-present",
    "test": "node ./scripts/test-social.js && node ./scripts/verify-mari-marketing-learning-v1.js",
    "test:mari-learning": "node ./scripts/verify-mari-marketing-learning-v1.js",
    "test:e2e": "node ./scripts/production-e2e-readiness.js",
    "security:audit": "node ./scripts/security-audit.js",
    "security:secrets": "node ./scripts/security/scan-secrets.js",
    "security:facebook-isolation": "node ./scripts/security/verify-facebook-tenant-isolation.js",
    "security:social-rls": "node ./scripts/security/verify-social-rls-hardening.js"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.395.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^4.3.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "vite": "^6.2.0"
  }
}

# =====================================================================
# Dockerfile.ralion — Ralion Next.js Dashboard (Server / Standalone Mode)
# Multi-stage build: deps → build → minimal production runner
# =====================================================================

# Stage 1: Install all workspace dependencies
FROM node:20-alpine AS deps
WORKDIR /app

# Copy workspace manifests only (for layer caching)
COPY package*.json .npmrc* ./
COPY apps/ralion/package*.json ./apps/ralion/

# Copy internal packages used by Ralion
COPY packages/ai/package*.json ./packages/ai/
COPY packages/auth/package*.json ./packages/auth/
COPY packages/core/package*.json ./packages/core/
COPY packages/database/package*.json ./packages/database/
COPY packages/integrations/package*.json ./packages/integrations/
COPY packages/modules/package*.json ./packages/modules/
COPY packages/ui/package*.json ./packages/ui/

RUN npm install --legacy-peer-deps 2>/dev/null || npm install --legacy-peer-deps

# Stage 2: Build Next.js in standalone mode
FROM node:20-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/ralion/node_modules ./apps/ralion/node_modules

# Copy source
COPY apps/ralion ./apps/ralion
COPY packages ./packages
COPY tsconfig.json ./

# Build-time env vars (baked into client-side JS bundles)
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_RASALI_PLATFORM_URL

ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_RASALI_PLATFORM_URL=$NEXT_PUBLIC_RASALI_PLATFORM_URL

# Use standalone (server) mode — NOT static export
ENV NEXT_STANDALONE=1
WORKDIR /app/apps/ralion
RUN npm run build

# Stage 3: Minimal production runtime image
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Copy standalone build & node_modules
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/ralion/node_modules ./apps/ralion/node_modules
COPY --from=builder /app/apps/ralion/.next/standalone ./
COPY --from=builder /app/apps/ralion/.next/static ./apps/ralion/.next/static
COPY --from=builder /app/apps/ralion/.next/static ./.next/static
COPY --from=builder /app/apps/ralion/public ./apps/ralion/public

EXPOSE 3000

# Start Next.js standalone server
CMD ["sh", "-c", "if [ -f apps/ralion/server.js ]; then node apps/ralion/server.js; elif [ -f server.js ]; then node server.js; else node $(find . -name server.js | head -n 1); fi"]

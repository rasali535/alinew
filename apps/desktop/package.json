{
  "name": "@ralion/desktop",
  "version": "2.4.3",
  "description": "Ralion Platform Desktop Application by Ras Ali Labs",
  "author": {
    "name": "Ras Ali Labs",
    "email": "support@rasalilabs.com",
    "url": "https://rasalilabs.com"
  },
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc && electron dist/main.js",
    "build": "tsc && node scripts/build-renderer.js",
    "copy:renderer": "node scripts/copy-renderer.js",
    "pack": "node scripts/copy-renderer.js && electron-builder --dir --x64 --config electron-builder.yml",
    "dist:win": "node scripts/copy-renderer.js && electron-builder --win nsis --x64 --config electron-builder.yml",
    "dist:mac": "electron-builder --mac --config electron-builder.yml",
    "dist:linux": "electron-builder --linux --config electron-builder.yml",
    "dist:all": "electron-builder --win --mac --linux --config electron-builder.yml",
    "publish:win": "node scripts/copy-renderer.js && electron-builder --win nsis --x64 --config electron-builder.yml -p always",
    "publish:all": "node scripts/copy-renderer.js && electron-builder --win --mac --linux --config electron-builder.yml -p always",
    "validate": "node scripts/validate-installer.js"
  },
  "dependencies": {
    "electron-log": "^5.1.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.8",
    "fs-extra": "^11.2.0",
    "node-machine-id": "^1.1.12",
    "systeminformation": "^5.33.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.2",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.2",
    "electron": "30.5.1",
    "electron-builder": "24.13.3",
    "typescript": "^5.4.5"
  }
}

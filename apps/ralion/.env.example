# Ras Ali Labs Ecosystem Environment Configuration
NEXT_PUBLIC_SUPABASE_URL=https://yidsfihagwttlmhfynmf.supabase.co
# Active modern publishable key (preferred)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# Legacy anon key (backward-compatibility fallback only)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key_here
NEXT_PUBLIC_RASALI_PLATFORM_URL=https://rasalilabs.com
NEXT_PUBLIC_PRODUCT_ID=ralion
NEXT_PUBLIC_APP_URL=https://rasalilabs.com/ralion
NEXT_PUBLIC_RALION_API_URL=https://ralion-dynamic-backend.onrender.com

# ----- Zernio Social Infrastructure (Server-Side Only) -----
ZERNIO_API_KEY=your_zernio_api_key_here
ZERNIO_WEBHOOK_SECRET=your_zernio_webhook_secret_here

# ----- Instagram Professional Login (Server-Side Only) -----
# Meta/Instagram "API setup with Instagram login" credentials.
# Do not reuse browser/public keys here and never expose the secret through NEXT_PUBLIC_*.
INSTAGRAM_APP_ID=your_instagram_app_id_here
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here
INSTAGRAM_GRAPH_VERSION=v26.0
# Minimum Ralion social scopes: profile + publishing. Add insights/comments/messages only when those features are enabled/reviewed.
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_content_publish

# ----- Mari Voice (Server-Side Only) -----
# Never expose this key through NEXT_PUBLIC_*.
OPENAI_API_KEY=your_openai_api_key_here
MARI_VOICE_MODEL=gpt-realtime-2.1
MARI_VOICE_NAME=marin

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@ralion/ui": ["../../packages/ui/src"],
      "@ralion/core": ["../../packages/core/src"],
      "@ralion/auth": ["../../packages/auth/src"],
      "@ralion/database": ["../../packages/database/src"],
      "@ralion/ai": ["../../packages/ai/src"],
      "@ralion/integrations": ["../../packages/integrations/src"],
      "@ralion/integrations/*": ["../../packages/integrations/src/*"],
      "@ralion/modules": ["../../packages/modules/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}

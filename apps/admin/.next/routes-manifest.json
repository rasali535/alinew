{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "/admin",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "basePath": false,
      "internal": true,
      "statusCode": 308,
      "regex": "^/admin$"
    },
    {
      "source": "/:file((?!\\.well-known(?:/.*)?)(?:[^/]+/)*[^/]+\\.\\w+)/",
      "destination": "/:file",
      "internal": true,
      "missing": [
        {
          "type": "header",
          "key": "x-nextjs-data"
        }
      ],
      "statusCode": 308,
      "regex": "^(?:/((?!\\.well-known(?:/.*)?)(?:[^/]+/)*[^/]+\\.\\w+))/$"
    },
    {
      "source": "/:notfile((?!\\.well-known(?:/.*)?)(?:[^/]+/)*[^/\\.]+)",
      "destination": "/:notfile/",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?!\\.well-known(?:/.*)?)(?:[^/]+/)*[^/\\.]+))$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/releases/[platform]",
      "regex": "^/api/releases/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPplatform": "nxtPplatform"
      },
      "namedRegex": "^/api/releases/(?<nxtPplatform>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin/analytics",
      "regex": "^/admin/analytics(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/analytics(?:/)?$"
    },
    {
      "page": "/admin/billing",
      "regex": "^/admin/billing(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/billing(?:/)?$"
    },
    {
      "page": "/admin/releases",
      "regex": "^/admin/releases(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/releases(?:/)?$"
    },
    {
      "page": "/portal",
      "regex": "^/portal(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/portal(?:/)?$"
    },
    {
      "page": "/products/ralion",
      "regex": "^/products/ralion(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/products/ralion(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}